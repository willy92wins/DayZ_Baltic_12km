def verify_crossings(h,v,p,f):
 changed=v!=h
 touch=changed[:-1,:-1]|changed[:-1,1:]|changed[1:,:-1]|changed[1:,1:]
 rr,cc=np.nonzero(touch&np.isfinite(p))

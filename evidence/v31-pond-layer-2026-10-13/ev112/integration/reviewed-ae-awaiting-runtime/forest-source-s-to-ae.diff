+def calibration_ratio(exp, got):
+    exp, got = np.asarray(exp,float), np.asarray(got,float)
+    ratio = np.divide(exp,got,out=np.ones_like(exp),where=got>=5)
+    return np.round(np.clip(ratio,1.,3.),4).tolist()
